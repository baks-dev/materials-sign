{% trans_default_domain('materials-sign.admin') %}

<div class="modal-dialog modal-dialog-centered " style="max-width: 800px;">
    {{ form_start(form) }}


    <div class="modal-content p-3 border-bottom border-5 border-primary">

        <div class="modal-header">
            <h5 class="modal-title">
                {{ 'Редактировать группу честных знаков'|trans }}
            </h5>
        </div>

        <div class="modal-body">
            {# {{  include('@manufacture-part/admin/newedit/_form/'~baks_settings.device~'/form.html.twig') }} #}

            <div class="clearfix mb-0 d-flex gap-3 align-items-center">
                <div class="w-75">
                    {{ form_row(form.number, {
                        label: 'Номер грузовой таможенной декларации (ГТД)'
                    }) }}
                </div>
                <div class="w-50">
                    <label for="edit_material_sign_form_number" class="form-label required">&nbsp;</label>
                    <div class="d-flex radio-buttons mb-3" data-buttons="true">
                        <label class="btn p-0 border-dotted rounded-3 active">
                            <span class="d-flex align-items-center">
                                <span class="flex-grow-1">
                                <span class="h6">
                                    <span class="form-check px-3 d-flex align-items-start">
                                        {{ form_widget(form.share, { label: false }) }}
                                        <span style="margin-top: 2px;">
                                            Доступен только владельцу
                                        </span>
                                    </span>
                                </span>
                                </span>
                            </span>
                        </label>
                    </div>

                </div>
            </div>


        </div>

        <div class="modal-footer ">
            {# {{ form_widget(form.comment, { attr: { placeholder : 'Комментарий'} }) }} #}

            <div class="mt-3 gap-3 d-flex">
                {# Отмена #}
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">
                    {{ 'btn.cancel'|trans({}, 'core.btn') }}
                </button>

                {# Сохранить #}
                {{ form_widget(form.material_sign, { label: '
                    <span>'~ 'btn.update'|trans({}, 'core.btn') ~'</span>
                    <span class="spinner-border spinner-border-sm vertical-middle d-none"></span>
			    '}) }}
            </div>
        </div>

    </div>

    {{ form_end(form) }}
</div>


